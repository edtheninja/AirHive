# Frontend
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080/ws

# Backend - Database
AIRHIVE_DB_URL=jdbc:postgresql://localhost:5432/airhive
AIRHIVE_DB_USERNAME=airhive_user
AIRHIVE_DB_PASSWORD=airhive_dev

# Backend - Redis
AIRHIVE_REDIS_HOST=localhost
AIRHIVE_REDIS_PORT=6379

# Backend - Security
AIRHIVE_JWT_SECRET=replace-with-a-secure-secret

# Backend - CORS
AIRHIVE_CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# Backend - WebSocket
AIRHIVE_WS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*